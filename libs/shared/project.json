{
	"name": "shared",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "libs/shared/src",
	"prefix": "lib",
	"projectType": "library",
	"tags": [],
	"targets": {
		"test": {
			"executor": "@nx/vitest:test",
			"outputs": ["{options.reportsDirectory}"],
			"options": {
				"reportsDirectory": "coverage/libs/shared"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		},
		"storybook": {
			"executor": "@storybook/angular:start-storybook",
			"options": {
				"port": 4400,
				"configDir": "libs/shared/.storybook",
				"browserTarget": "shared:build-storybook",
				"compodoc": false,
				"styles": ["libs/shared/.storybook/styles.scss"],
				"stylePreprocessorOptions": {
					"includePaths": ["libs/shared/src/lib/styles"]
				}
			},
			"configurations": {
				"ci": {
					"quiet": true
				}
			}
		},
		"build-storybook": {
			"executor": "@storybook/angular:build-storybook",
			"outputs": ["{options.outputDir}"],
			"options": {
				"outputDir": "dist/storybook/shared",
				"configDir": "libs/shared/.storybook",
				"browserTarget": "shared:build-storybook",
				"compodoc": false,
				"styles": ["libs/shared/.storybook/styles.scss"],
				"stylePreprocessorOptions": {
					"includePaths": ["libs/shared/src/lib/styles"]
				}
			},
			"configurations": {
				"ci": {
					"quiet": true
				}
			}
		},
		"test-storybook": {
			"executor": "nx:run-commands",
			"options": {
				"command": "test-storybook -c libs/shared/.storybook --url=http://localhost:4400"
			}
		},
		"static-storybook": {
			"executor": "@nx/web:file-server",
			"dependsOn": ["build-storybook"],
			"options": {
				"buildTarget": "shared:build-storybook",
				"staticFilePath": "dist/storybook/shared",
				"spa": true
			},
			"configurations": {
				"ci": {
					"buildTarget": "shared:build-storybook:ci"
				}
			}
		}
	}
}
