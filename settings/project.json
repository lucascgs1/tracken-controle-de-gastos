{
	"name": "settings",
	"$schema": "../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"prefix": "app",
	"sourceRoot": "settings/src",
	"tags": [],
	"targets": {
		"build": {
			"executor": "@nx/angular:webpack-browser",
			"outputs": ["{options.outputPath}"],
			"options": {
				"outputPath": "dist/settings",
				"index": "settings/src/index.html",
				"main": "settings/src/main.ts",
				"tsConfig": "settings/tsconfig.app.json",
				"inlineStyleLanguage": "scss",
				"assets": [
					{
						"glob": "**/*",
						"input": "settings/public"
					}
				],
				"styles": ["settings/src/styles.scss"],
				"customWebpackConfig": {
					"path": "settings/webpack.config.ts"
				},
				"stylePreprocessorOptions": {
					"includePaths": ["libs/shared/src/lib/styles"]
				}
			},
			"configurations": {
				"production": {
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "500kb",
							"maximumError": "1mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumWarning": "4kb",
							"maximumError": "8kb"
						}
					],
					"outputHashing": "all",
					"customWebpackConfig": {
						"path": "settings/webpack.prod.config.ts"
					}
				},
				"development": {
					"buildOptimizer": false,
					"optimization": false,
					"vendorChunk": true,
					"extractLicenses": false,
					"sourceMap": true,
					"namedChunks": true
				}
			},
			"defaultConfiguration": "production"
		},
		"serve": {
			"continuous": true,
			"executor": "@nx/angular:dev-server",
			"options": {
				"port": 4202,
				"publicHost": "http://localhost:4202"
			},
			"configurations": {
				"production": {
					"buildTarget": "settings:build:production"
				},
				"development": {
					"buildTarget": "settings:build:development"
				}
			},
			"defaultConfiguration": "development",
			"dependsOn": ["shell:serve"]
		},
		"extract-i18n": {
			"executor": "@angular-devkit/build-angular:extract-i18n",
			"options": {
				"buildTarget": "settings:build"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		},
		"test": {
			"executor": "@nx/vitest:test",
			"outputs": ["{options.reportsDirectory}"],
			"options": {
				"reportsDirectory": "coverage/settings"
			}
		},
		"serve-static": {
			"continuous": true,
			"executor": "@nx/web:file-server",
			"defaultConfiguration": "production",
			"options": {
				"buildTarget": "settings:build",
				"port": 4202,
				"watch": false
			},
			"configurations": {
				"development": {
					"buildTarget": "settings:build:development"
				},
				"production": {
					"buildTarget": "settings:build:production"
				}
			}
		}
	}
}
